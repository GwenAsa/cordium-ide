{
  "productName": "Cordium",
  "version": "0.7.0",
  "identifier": "com.cordium.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cordium",
        "width": 1100,
        "height": 720,
        "minWidth": 380,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight code editor for Discord bots",
    "longDescription": "Cordium is an ultra-light, Discord-styled code editor for building discord.py and discord.js bots, with smart autocomplete, builders and a built-in test chat.",
    "resources": {
      "resources/pyls": "pyls"
    }
  }
}